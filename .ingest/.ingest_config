# InGest Directory Management Configuration
# Controls how processed files are handled

# File lifecycle settings
ARCHIVE_PROCESSED_FILES=true     # Set to false to delete instead of archive
KEEP_FAILED_FILES=true          # Keep failed files for retry
AUTO_CLEANUP_DAYS=30            # Archive files older than X days
MAX_RAW_DOCUMENTS=100           # Alert if more than X files pending

# Processing settings
BATCH_SIZE=10                   # Process files in batches
RETRY_FAILED_FILES=true         # Automatically retry failed files
BACKUP_BEFORE_CLEANUP=true      # Create backup before cleanup

# Monitoring
LOG_PROCESSING_HISTORY=true     # Keep processing logs
ALERT_ON_FAILURES=true          # Alert if processing fails
